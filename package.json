{
  "name": "fucustomer",
  "version": "0.1.0",
  "private": true,
  "description": "奧客退散 FUCustomer — first-person co-op store management (1-5 players)",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/sim.test.ts tests/career.test.ts",
    "test:net": "node --import tsx --test --test-concurrency=1 tests/net.test.ts",
    "test:e2e": "node tests/e2e/solo-smoke.mjs && node tests/e2e/multi-browser.mjs && node tests/e2e/career.mjs && node tests/e2e/round3.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:net",
    "balance": "tsx scripts-balance.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}